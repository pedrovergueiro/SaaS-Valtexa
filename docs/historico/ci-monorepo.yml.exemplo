# CI da plataforma ValTexa (F19). Quatro trabalhos independentes, um por produto:
# Rover Runtime, SaaS (com Postgres e a integração com o rover/), console web e IA.
# Nenhum segredo é necessário: os testes usam dublês do modelo e chaves geradas na hora.
name: ci

on:
  push:
  pull_request:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  rover:
    name: Rover Runtime (rover/)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: rover
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install -e ".[dev]"
      - run: ruff check .
      - run: pytest

  saas:
    name: SaaS (saas/) com Postgres
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: valtexa
          POSTGRES_PASSWORD: valtexa
          POSTGRES_DB: valtexa_test
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U valtexa" --health-interval 5s --health-timeout 5s
          --health-retries 10
    env:
      PG: postgresql+psycopg://valtexa:valtexa@localhost:5432
    defaults:
      run:
        working-directory: saas
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      # requirements-dev.txt instala também ../rover (teste de integração e ponta a ponta).
      - run: pip install -r requirements-dev.txt
      - run: ruff check .
      - name: Migrações no Postgres (do zero, volta e sobe)
        run: |
          psql "postgresql://valtexa:valtexa@localhost:5432/valtexa_test" -c "create database valtexa_mig"
          DATABASE_URL=$PG/valtexa_mig alembic upgrade head
          DATABASE_URL=$PG/valtexa_mig alembic downgrade -1
          DATABASE_URL=$PG/valtexa_mig alembic upgrade head
      - name: Testes no SQLite
        run: pytest -o addopts="--strict-markers" -q
      - name: Testes no Postgres
        run: TEST_DATABASE_URL=$PG/valtexa_test pytest -o addopts="--strict-markers" -q

  web:
    name: Console (saas/web)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: saas/web
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: npm
          cache-dependency-path: saas/web/package-lock.json
      - run: npm ci
      - run: npm run build
      - run: npx vitest run

  ia:
    name: IA (ia/)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: ia
    env:
      KERAS_BACKEND: torch
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install torch==2.11.0 --index-url https://download.pytorch.org/whl/cpu
      - run: pip install -r requirements.txt -r requirements-dev.txt
      # dNATY sem as dependências declaradas (puxariam o torchvision e trocariam o
      # torch). Licença BSL 1.1: uso comercial pede licença própria do autor.
      - run: pip install --no-deps dnaty==2.2.1 scipy tqdm
      # Os 5 erros de lint dos arquivos de terreno (trabalho de outra pessoa) são conhecidos.
      - run: >-
          ruff check . --exclude
          app/basemap.py,app/boundary.py,app/obstacles.py,app/terrain.py,app/terrain_api.py,tests/test_terrain_api.py
      - run: pytest -q
