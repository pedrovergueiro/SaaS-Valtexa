# Configuração da plataforma ValTexa.
#
# Copie para `.env`. Todos os valores têm padrão: sem nenhuma variável definida,
# `uvicorn valtexa.main:app` sobe um ambiente de desenvolvimento completo.
#
# Em produção, `/health` lista o que ainda impede o processo de ser considerado
# produção, e o `lifespan` **recusa subir** com ENVIRONMENT=production enquanto
# a lista não estiver vazia.

# development | staging | production | test
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- banco e armazenamento ---------------------------------------------------
# SQLite serve o piloto. Produção é Postgres: a ingestão de telemetria escreve
# concorrentemente, e o SQLite serializa.
# DATABASE_URL=postgresql+psycopg://valtexa:senha@localhost:5432/valtexa
DATABASE_URL=sqlite:///./valtexa.db
STORAGE_DIR=./storage
# Limite por arquivo JÁ MONTADO. Não é o limite de uma coleta: o lote sobe em
# pedaços e o teto dele é o do armazenamento contratado. Ortomosaico passa de
# 64 MB com folga — suba este número antes de importar um.
MAX_ASSET_MB=64

# --- segredos ----------------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Os dois PRECISAM ser diferentes. Se fossem iguais, vazar a sessão de um
# usuário passaria a permitir forjar uma missão assinada — a fronteira entre
# "alguém entrou na conta" e "alguém mandou o drone pulverizar" desapareceria.
#
# Em produção (Parte 9) a API e o worker NÃO SOBEM se SESSION_SECRET,
# COMMAND_SIGNING_SECRET, OTA_SIGNING_SECRET ou INFERENCE_SERVICE_TOKEN estiverem
# vazios, com o padrão, com menos de 32 caracteres, com cara de exemplo ou iguais
# entre si. Prefira arquivos montados (SECRETS_DIR, padrão /run/secrets): um
# arquivo por segredo, com o nome do campo em minúsculas. Rotação: docs/SEGURANCA.md.
SESSION_SECRET=dev-only-change-me
COMMAND_SIGNING_SECRET=dev-only-change-me
# OTA_SIGNING_SECRET=
# SECRETS_DIR=/run/secrets
# Identificador da chave de assinatura, para rotacionar sem downtime.
COMMAND_SIGNING_KEY_ID=k1

# Senha inicial das contas da EQUIPE DA VALTEXA (PLATFORM_TEAM, em
# valtexa/seed.py). Elas enxergam todos os clientes, então esta linha vale tanto
# quanto o banco inteiro.
#
# Vazia por padrão, e é deliberado: com padrão, toda instalação nasceria com a
# mesma senha de administrador de plataforma. Defina uma vez para criar as
# contas; depois disso o seed não a usa mais — ele nunca sobrescreve conta que
# já existe, e a troca se faz pelo console.
# PLATFORM_ADMIN_PASSWORD=

# --- protocolo do dispositivo ------------------------------------------------
# Tolerância do relógio do robô, em segundos. Requisição fora da janela é
# recusada: é o que impede reapresentar uma gravação antiga.
DEVICE_CLOCK_SKEW_SECONDS=300
DEVICE_SESSION_TTL_SECONDS=3600
USER_SESSION_TTL_SECONDS=43200
# Validade de uma missão assinada. Comando expirado nunca é executado.
COMMAND_TTL_SECONDS=1800
NONCE_RETENTION_SECONDS=900
MAX_TELEMETRY_BATCH=500
MAX_SYNC_BATCH=1000

# --- inferência (repositório VALTEXA-B) --------------------------------------
INFERENCE_URL=http://127.0.0.1:8000
INFERENCE_TIMEOUT_SECONDS=30
INFERENCE_ENABLED=true
# Substitui os modelos por analisadores falsos e determinísticos. Só para o
# simulador — é recusado em produção.
SIMULATED_INFERENCE=false

# --- achar a fazenda e o relevo (cadastro do talhão) --------------------------
# Google: DUAS chaves. A do servidor (Geocoding API, restrita por IP) e a do
# navegador (Map Tiles API: satélite no console, restrita por referenciador).
# Exige faturamento ligado no projeto do Google Cloud. Os termos do Google só
# deixam mostrar endereço achado pelo Google sobre mapa do Google: sem as duas,
# a busca usa o OpenStreetMap. Nunca commite a chave — ela fica só no .env.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TILES_KEY=
GEOCODER_OSM_URL=https://nominatim.openstreetmap.org
# Relevo (DEM) no formato OpenTopoData. Vazio: o plano trata o talhão como plano
# e diz isso. Ex.: https://api.opentopodata.org/v1/srtm30m (público, pouca cota).
ELEVATION_URL=

# Abaixo disso o diagnóstico é inconclusivo. Medido em VALTEXA-B/MODELS.md:
# sozinho intercepta 17% de uma doença fora do catálogo.
MIN_CONFIDENCE=0.70
# Acima disso a imagem destoa do que o modelo conhece e vai para o agrônomo.
NOVELTY_THRESHOLD=1.0
# Diferença máxima de confiança entre as duas análises para aceitar a
# concordância sem revisão humana.
AGREEMENT_TOLERANCE=0.15

# --- regras agronômicas ------------------------------------------------------
DECISION_MIN_CONFIDENCE_FOR_APPLICATION=0.85
DECISION_MIN_INCIDENCE=0.05

# --- segurança operacional ---------------------------------------------------
SAFETY_MIN_BATTERY_PERCENT=35
SAFETY_MAX_WIND_MS=8
# Margem interna do polígono autorizado, em metros. Aplica-se sempre para
# dentro, nunca para fora.
GEOFENCE_MARGIN_M=5

# --- energia (política embarcada no robô) ------------------------------------
ENERGY_RESERVE_PERCENT=20
ENERGY_EMERGENCY_PERCENT=10

# --- HTTP --------------------------------------------------------------------
# Origens do frontend, separadas por vírgula. '*' desabilita credenciais e é
# recusado em produção.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- armazenamento de objetos ------------------------------------------------
# local | s3. Com s3, as mesmas chaves do disco vão para o bucket.
STORAGE_BACKEND=local
# S3_BUCKET=valtexa-assets
# S3_PREFIX=valtexa
# S3_ENDPOINT_URL=https://<conta>.r2.cloudflarestorage.com
# S3_REGION=sa-east-1
# S3_ADDRESSING_STYLE=path          # MinIO
# Com s3, os chunks de upload (Rover e coletas) também vão para o bucket (_staging/):
# qualquer réplica da API recebe qualquer chunk. Ver docs/DEPLOY.md (raiz).
# S3_PRESIGN_SECONDS=300            # validade da URL assinada de download
# Lifecycle (python -m valtexa.services.storage --ciclo-de-vida). Vazio desliga.
# S3_STAGING_DAYS=3
# S3_INFREQUENT_AFTER_DAYS=30
# S3_ARCHIVE_AFTER_DAYS=365
# S3_LOGS_EXPIRE_DAYS=

# --- coordenação entre réplicas (Redis) --------------------------------------
# Limite de taxa dos robôs e travas do worker. Vazio: em memória, por processo
# (só serve com uma réplica). Obrigatório em produção.
# REDIS_URL=redis://:senha@redis:6379/0

# --- upload de coleta --------------------------------------------------------
# Onde os pedaços se acumulam até o arquivo fechar. Vazio usa STORAGE_DIR/_upload.
#
# É o único estado do upload que não vive no banco nem no bucket, e por isso os
# pedaços de um mesmo arquivo precisam cair sempre na MESMA máquina. Com mais de
# uma réplica da API, aponte para um volume compartilhado; sem isso, um arquivo
# que troque de réplica no meio do envio responde 409 para sempre e nunca fecha.
# Com STORAGE_BACKEND=s3 e esta variável vazia, /health acusa a pendência.
# UPLOAD_STAGING_DIR=/mnt/valtexa-upload

# --- versão do modelo por cultura -------------------------------------------
# cultura:modelo, para pôr todos os talhões de uma cultura numa versão sem mexer
# em cada um. O talhão (PUT /v1/fields/{id}/ai-model) tem precedência; vazio =
# a recomendada do catálogo. Ex.: banana:banana-foliar-cc,citrus:citrus-foliar-cc
# põe banana e citros na versão só com dado comercial (o PlantSeg é CC BY-NC).
PRIMARY_MODELS=

# --- segundo analisador ------------------------------------------------------
# cultura:modelo do VALTEXA-B. Vazio = um analisador só, e nada chega a
# AI_VALIDATED (tudo passa pelo agrônomo). Recomendado: corn:leaf-foliar-b —
# a discordância entre os dois vira informação no console.
SECONDARY_MODELS=
# true = a concordância entre os dois valida sozinha. A medição em
# docs/AI_PIPELINE.md mostra 40% de erros compartilhados: repita-a com imagens
# da própria frota antes de ligar.
SECONDARY_MODEL_INDEPENDENT=false

# --- notificações (seção 48) ------------------------------------------------
# Sem SMTP_HOST o e-mail não sai: a entrega fica "não enviado", com o motivo, e o
# aviso continua na central do console. A senha vem do cofre, nunca do código.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ValTexa <nao-responda@valtexa.com.br>
SMTP_STARTTLS=true
SMTP_SSL=false
# Endereço público do console, para o link do aviso no e-mail.
CONSOLE_URL=

# --- observabilidade (Parte 7, seções 34 e 35) ------------------------------
# Token que o Prometheus manda em /metrics (Authorization: Bearer). Gere com
# python -c "import secrets;print(secrets.token_urlsafe(32))" e guarde no cofre.
# Vazio: só a equipe da ValTexa logada lê /metrics. Ver docs/OBSERVABILIDADE.md.
METRICS_TOKEN=
# texto (terminal) ou json (uma linha JSON por registro, com request_id e cliente)
LOG_FORMAT=texto
METRICS_FLUSH_SECONDS=30
API_METRICS_RETENTION_DAYS=7
ALERTS_EVERY_SECONDS=60

# --- processos ---------------------------------------------------------------
# Com várias réplicas da API: false aqui e `python -m valtexa.worker` à parte.
EVENT_WORKER_IN_API=true
TELEMETRY_RETENTION_DAYS=90
# Serve o console (web/dist) na raiz quando o build existir.
SERVE_WEB=true
